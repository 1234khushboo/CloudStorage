PORT=5000
AWS_REGION=ap-south-1
# Set AWS_MODE=aws to use real AWS services. Leave as local to run without AWS credentials.
AWS_MODE=local
S3_BUCKET=your-cloudbox-bucket-name
DYNAMODB_TABLE=CloudBoxFiles
# Optional: configure Cognito later; demo mode uses a simple user identity header.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
